<Project Sdk="Microsoft.NET.Sdk">
  <!-- Golden-oracle harness: runs genuine BizHawk NesHawk headless to produce per-frame RAM dumps
       for validating the C++ translation byte-exactly. BizHawk targets net48; we host its (pure
       managed) NES path on modern .NET via the compat shim. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <AssemblyName>nesHawkOracle</AssemblyName>
    <RootNamespace>NesHawkOracle</RootNamespace>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="BizHawk.Emulation.Cores">
      <HintPath>$(HOME)/BizHawk/src/BizHawk.Emulation.Cores/bin/Release/BizHawk.Emulation.Cores.dll</HintPath>
    </Reference>
    <Reference Include="BizHawk.Emulation.Common">
      <HintPath>$(HOME)/BizHawk/src/BizHawk.Emulation.Cores/bin/Release/BizHawk.Emulation.Common.dll</HintPath>
    </Reference>
    <Reference Include="BizHawk.Common">
      <HintPath>$(HOME)/BizHawk/src/BizHawk.Emulation.Cores/bin/Release/BizHawk.Common.dll</HintPath>
    </Reference>
  </ItemGroup>
  <!-- Copy the full BizHawk Release output next to the harness so runtime probing finds transitive deps -->
  <ItemGroup>
    <None Include="$(HOME)/BizHawk/src/BizHawk.Emulation.Cores/bin/Release/*.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
