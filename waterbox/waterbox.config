{
  "coreName": "QuickerNesHawk",
  "author": "Sergio Martin (NesHawk: the BizHawk team)",
  "version": "1.0.0",
  "url": "https://github.com/ToolAssisted-run/QuickerNesHawk",
  "systemId": "NES",
  "romFile": "rom",
  "deterministic": true,
  "memoryLayoutMiB": [
    16,
    16,
    8,
    16,
    16
  ],
  "_memoryLayoutMiB_note": "sbrk, sealed, invis, plain, mmap. Every savestate costs work proportional to the DECLARED layout, not to what the core uses, so this is sized for an NES cart (a few hundred KB of machine plus the PRG image) rather than left generous.",
  "video": {
    "width": 256,
    "height": 240,
    "virtualWidth": 293,
    "virtualHeight": 240,
    "vsyncNumerator": 3579546,
    "vsyncDenominator": 59561,
    "_vsync_note": "NesHawk's NTSC rate (cpuclockrate*2 / 59561). The region is a user setting, so the core answers GetVsyncNumerator/GetVsyncDenominator after Init and those win; these are the fallback.",
    "getBgra": "GetVideoBgra"
  },
  "audio": {
    "samplesPerFrame": 1024,
    "_samplesPerFrame_note": "capacity, not the count: the core exports GetAudioSampleCount and hands over the real number each frame (~735 NTSC, ~882 PAL).",
    "channels": 1,
    "get": "GetAudio"
  },
  "input": {
    "name": "NES Controller",
    "buttons": [
      "P1 A",
      "P1 B",
      "P1 Select",
      "P1 Start",
      "P1 Up",
      "P1 Down",
      "P1 Left",
      "P1 Right",
      "P2 A",
      "P2 B",
      "P2 Select",
      "P2 Start",
      "P2 Up",
      "P2 Down",
      "P2 Left",
      "P2 Right",
      "Reset",
      "FDS Eject",
      "FDS Insert 0",
      "FDS Insert 1",
      "FDS Insert 2",
      "FDS Insert 3"
    ]
  },
  "lag": {
    "inputWasRead": "InputWasRead"
  },
  "extensions": {
    ".nes": "NES",
    ".fds": "NES"
  },
  "settings": [
    {
      "name": "region",
      "display": "Region",
      "description": "Which machine this is. Changes the frame rate, the CPU clock and the PPU's scanline counts, so it reboots the core. BizHawk's 'Default' resolves the region from its cart database, which this core has no equivalent of - it starts NTSC.",
      "type": "enum",
      "options": [
        "ntsc",
        "pal",
        "dendy"
      ],
      "default": "ntsc",
      "sync": true
    },
    {
      "name": "port1",
      "display": "Left Port Peripheral",
      "description": "What is plugged into controller port 1. Only the standard pad is translated so far; NesHawk also offers zappers, arkanoid paddles and the four-score.",
      "type": "enum",
      "options": [
        "none",
        "gamepad"
      ],
      "default": "gamepad",
      "sync": true
    },
    {
      "name": "port2",
      "display": "Right Port Peripheral",
      "description": "What is plugged into controller port 2. An empty port reads back as a constant 0, which is observably different from a connected pad - some games and glitches depend on it.",
      "type": "enum",
      "options": [
        "none",
        "gamepad"
      ],
      "default": "none",
      "sync": true
    },
    {
      "name": "initialWRamStatePattern",
      "display": "Initial RAM State",
      "description": "The byte pattern the 2KB of work RAM powers on with, as hex (e.g. 'FF' or 'DE AD BE EF'). Empty means fceux's pattern, which is what NesHawk uses unless told otherwise; a few games (Cybernoid, Huang Di) behave differently.",
      "type": "string",
      "default": "",
      "sync": true
    },
    {
      "name": "allowMoreThanEightSprites",
      "display": "Allow More Than Eight Sprites",
      "description": "Draw every sprite on a scanline instead of the eight the hardware manages, which removes flicker. BizHawk files this under presentation, but it changes what sprite evaluation puts in secondary OAM and can therefore change a sprite-zero hit, so here it shapes the machine and reboots the core.",
      "type": "bool",
      "default": false,
      "sync": true
    },
    {
      "name": "palette",
      "display": "Palette",
      "description": "Which of NesHawk's palettes to colour the picture with. quickNES is its default; 2c03/2c04 are the arcade PPUs' own palettes.",
      "type": "enum",
      "options": [
        "quickNES",
        "fceux",
        "2c03_2c05",
        "2c04_001",
        "2c04_002",
        "2c04_003",
        "2c04_004"
      ],
      "default": "quickNES",
      "sync": false
    },
    {
      "name": "dispBackground",
      "display": "Display Background",
      "description": "Draw the background layer. Presentation only - the PPU still renders it, so sprite-zero hits and timing are unaffected.",
      "type": "bool",
      "default": true,
      "sync": false
    },
    {
      "name": "dispSprites",
      "display": "Display Sprites",
      "description": "Draw the sprite layer. Presentation only, as above.",
      "type": "bool",
      "default": true,
      "sync": false
    },
    {
      "name": "clipLeftAndRight",
      "display": "Clip Left and Right",
      "description": "Blank the 8 leftmost and rightmost columns, which real TVs cut off and which many games leave garbage in. BizHawk narrows the picture instead; a package declares one frame size, so here the columns go black.",
      "type": "bool",
      "default": false,
      "sync": false
    },
    {
      "name": "backgroundColor",
      "display": "Backdrop Colour",
      "description": "Colour to paint pixels the PPU never drew, as 0xRRGGBB (decimal). -1 leaves them as the palette's own backdrop, which is what NesHawk does with a zero alpha byte.",
      "type": "int",
      "min": -1,
      "max": 16777215,
      "default": -1,
      "sync": false
    },
    {
      "name": "ntscTopLine",
      "display": "NTSC First Scanline",
      "description": "First scanline shown on an NTSC machine. NesHawk crops the picture; here the lines outside go black, since the frame size is fixed by the package.",
      "type": "int",
      "min": 0,
      "max": 239,
      "default": 8,
      "sync": false
    },
    {
      "name": "ntscBottomLine",
      "display": "NTSC Last Scanline",
      "description": "Last scanline shown on an NTSC machine.",
      "type": "int",
      "min": 0,
      "max": 239,
      "default": 231,
      "sync": false
    },
    {
      "name": "palTopLine",
      "display": "PAL First Scanline",
      "description": "First scanline shown on a PAL or Dendy machine.",
      "type": "int",
      "min": 0,
      "max": 239,
      "default": 0,
      "sync": false
    },
    {
      "name": "palBottomLine",
      "display": "PAL Last Scanline",
      "description": "Last scanline shown on a PAL or Dendy machine.",
      "type": "int",
      "min": 0,
      "max": 239,
      "default": 239,
      "sync": false
    },
    {
      "name": "apuVolume",
      "display": "APU Volume",
      "description": "Output gain of the sound chip, 1 to 10, exactly NesHawk's own APU volume slider.",
      "type": "int",
      "min": 1,
      "max": 10,
      "default": 1,
      "sync": false
    }
  ],
  "firmware": [
    {
      "id": "bios",
      "display": "Family Computer Disk System BIOS",
      "description": "The 8 KiB boot rom inside the Disk System's RAM adapter. Needed by any .fds disk image and by nothing else, so cartridges load without it.",
      "size": 8192,
      "sha1": [
        "57FE1BDEE955BB48D357E463CCBF129496930B62",
        "E4E41472C454F928E53EB10E0509BF7D1146ECC1"
      ],
      "required": false
    }
  ]
}
