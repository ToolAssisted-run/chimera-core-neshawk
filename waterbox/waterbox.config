{
  "coreName": "QuickerNesHawk",
  "systemNames": {
    "NES": "Nintendo Entertainment System"
  },
  "author": "Sergio Martin (NesHawk: the BizHawk team)",
  "version": "1.0.0",
  "url": "https://github.com/ToolAssisted-run/QuickerNesHawk",
  "machineSetting": "machine",
  "machines": [
    {
      "id": "NES",
      "label": "NES / Famicom (cartridge)",
      "when": [
        "nes"
      ],
      "input": {
        "name": "NES Controller",
        "picture": "pictures/nes-controller.png",
        "buttons": [
          "P1 A",
          "P1 B",
          "P1 Select",
          "P1 Start",
          "P1 Up",
          "P1 Down",
          "P1 Left",
          "P1 Right",
          "P2 A",
          "P2 B",
          "P2 Select",
          "P2 Start",
          "P2 Up",
          "P2 Down",
          "P2 Left",
          "P2 Right",
          "Reset"
        ],
        "mnemonics": {
          "A": "A",
          "B": "B",
          "Select": "s",
          "Start": "S",
          "Up": "U",
          "Down": "D",
          "Left": "L",
          "Right": "R",
          "Reset": "r"
        }
      },
      "extensions": {
        ".nes": "NES"
      }
    },
    {
      "id": "NES",
      "label": "Famicom Disk System",
      "when": [
        "fds"
      ],
      "extensions": {
        ".fds": "NES"
      }
    }
  ],
  "romFile": "rom",
  "deterministic": true,
  "memoryLayoutMiB": [
    16,
    16,
    8,
    16,
    16
  ],
  "_memoryLayoutMiB_note": "sbrk, sealed, invis, plain, mmap. Every savestate costs work proportional to the DECLARED layout, not to what the core uses, so this is sized for an NES cart (a few hundred KB of machine plus the PRG image) rather than left generous.",
  "video": {
    "width": 256,
    "height": 240,
    "virtualWidth": 293,
    "virtualHeight": 240,
    "vsyncNumerator": 3579546,
    "vsyncDenominator": 59561,
    "_vsync_note": "NesHawk's NTSC rate (cpuclockrate*2 / 59561). The region is a user setting, so the core answers GetVsyncNumerator/GetVsyncDenominator after Init and those win; these are the fallback.",
    "getBgra": "GetVideoBgra"
  },
  "audio": {
    "samplesPerFrame": 1024,
    "_samplesPerFrame_note": "capacity, not the count: the core exports GetAudioSampleCount and hands over the real number each frame (~735 NTSC, ~882 PAL).",
    "channels": 1,
    "get": "GetAudio"
  },
  "input": {
    "name": "NES Controller",
    "buttons": [
      "P1 A",
      "P1 B",
      "P1 Select",
      "P1 Start",
      "P1 Up",
      "P1 Down",
      "P1 Left",
      "P1 Right",
      "P2 A",
      "P2 B",
      "P2 Select",
      "P2 Start",
      "P2 Up",
      "P2 Down",
      "P2 Left",
      "P2 Right",
      "Reset",
      "FDS Eject",
      "FDS Insert 0",
      "FDS Insert 1",
      "FDS Insert 2",
      "FDS Insert 3"
    ],
    "mnemonics": {
      "A": "A",
      "B": "B",
      "Select": "s",
      "Start": "S",
      "Up": "U",
      "Down": "D",
      "Left": "L",
      "Right": "R",
      "Reset": "r",
      "FDS Eject": "E",
      "FDS Insert 0": "0",
      "FDS Insert 1": "1",
      "FDS Insert 2": "2",
      "FDS Insert 3": "3"
    }
  },
  "lag": {
    "inputWasRead": "InputWasRead"
  },
  "settings": [
    {
      "name": "machine",
      "display": "setting.machine",
      "description": "setting.machine.about",
      "type": "enum",
      "options": [
        "nes",
        "fds"
      ],
      "default": "nes"
    },
    {
      "name": "region",
      "display": "setting.region",
      "description": "setting.region.about",
      "type": "enum",
      "options": [
        "ntsc",
        "pal",
        "dendy"
      ],
      "default": "ntsc"
    },
    {
      "name": "port1",
      "display": "setting.port1",
      "description": "setting.port1.about",
      "type": "enum",
      "options": [
        "none",
        "gamepad"
      ],
      "default": "gamepad"
    },
    {
      "name": "port2",
      "display": "setting.port2",
      "description": "setting.port2.about",
      "type": "enum",
      "options": [
        "none",
        "gamepad"
      ],
      "default": "none"
    },
    {
      "name": "initialWRamStatePattern",
      "display": "setting.initialwramstatepattern",
      "description": "setting.initialwramstatepattern.about",
      "type": "string",
      "default": ""
    },
    {
      "name": "allowMoreThanEightSprites",
      "display": "setting.allowmorethaneightsprites",
      "description": "setting.allowmorethaneightsprites.about",
      "type": "bool",
      "default": false
    },
    {
      "name": "palette",
      "display": "setting.palette",
      "description": "setting.palette.about",
      "type": "enum",
      "options": [
        "quickNES",
        "fceux",
        "2c03_2c05",
        "2c04_001",
        "2c04_002",
        "2c04_003",
        "2c04_004"
      ],
      "default": "quickNES"
    },
    {
      "name": "dispBackground",
      "display": "setting.dispbackground",
      "description": "setting.dispbackground.about",
      "type": "bool",
      "default": true
    },
    {
      "name": "dispSprites",
      "display": "setting.dispsprites",
      "description": "setting.dispsprites.about",
      "type": "bool",
      "default": true
    },
    {
      "name": "clipLeftAndRight",
      "display": "setting.clipleftandright",
      "description": "setting.clipleftandright.about",
      "type": "bool",
      "default": false
    },
    {
      "name": "backgroundColor",
      "display": "setting.backgroundcolor",
      "description": "setting.backgroundcolor.about",
      "type": "int",
      "min": -1,
      "max": 16777215,
      "default": -1
    },
    {
      "name": "ntscTopLine",
      "display": "setting.ntsctopline",
      "description": "setting.ntsctopline.about",
      "type": "int",
      "min": 0,
      "max": 239,
      "default": 8
    },
    {
      "name": "ntscBottomLine",
      "display": "setting.ntscbottomline",
      "description": "setting.ntscbottomline.about",
      "type": "int",
      "min": 0,
      "max": 239,
      "default": 231
    },
    {
      "name": "palTopLine",
      "display": "setting.paltopline",
      "description": "setting.paltopline.about",
      "type": "int",
      "min": 0,
      "max": 239,
      "default": 0
    },
    {
      "name": "palBottomLine",
      "display": "setting.palbottomline",
      "description": "setting.palbottomline.about",
      "type": "int",
      "min": 0,
      "max": 239,
      "default": 239
    },
    {
      "name": "apuVolume",
      "display": "setting.apuvolume",
      "description": "setting.apuvolume.about",
      "type": "int",
      "min": 1,
      "max": 10,
      "default": 1
    },
    {
      "name": "fdsBios",
      "display": "setting.fdsbios",
      "description": "setting.fdsbios.about",
      "type": "enum",
      "options": [
        "nintendo",
        "twinFamicom"
      ],
      "default": "nintendo",
      "exposedWhen": {
        "setting": "machine",
        "is": "fds"
      }
    }
  ],
  "firmware": [
    {
      "id": "bios",
      "display": "common.family_computer_disk_system_bios",
      "description": "common.the_8_kb_boot_rom_inside_the",
      "size": 8192,
      "sha1": "57FE1BDEE955BB48D357E463CCBF129496930B62",
      "name": "disksys.rom",
      "label": "firmware.bios.label",
      "requiredWhen": {
        "all": [
          {
            "setting": "machine",
            "is": "fds"
          },
          {
            "setting": "fdsBios",
            "is": "nintendo"
          }
        ]
      }
    },
    {
      "id": "bios",
      "display": "common.family_computer_disk_system_bios",
      "description": "common.the_8_kb_boot_rom_inside_the",
      "size": 8192,
      "sha1": "E4E41472C454F928E53EB10E0509BF7D1146ECC1",
      "name": "disksys.rom",
      "label": "firmware.bios.label_2",
      "requiredWhen": {
        "all": [
          {
            "setting": "machine",
            "is": "fds"
          },
          {
            "setting": "fdsBios",
            "is": "twinFamicom"
          }
        ]
      }
    }
  ]
}
