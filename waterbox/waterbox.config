{
  "coreName": "QuickerNesHawk",
  "systemNames": {
    "NES": "Nintendo Entertainment System"
  },
  "author": "Sergio Martin (NesHawk: the BizHawk team)",
  "version": "1.0.0",
  "url": "https://github.com/ToolAssisted-run/QuickerNesHawk",
  "machineSetting": "machine",
  "machines": [
    {
      "id": "NES",
      "label": "NES / Famicom (cartridge)",
      "when": [
        "nes"
      ],
      "input": {
        "name": "NES Controller",
        "picture": "pictures/nes-controller.png",
        "buttons": [
          "P1 A",
          "P1 B",
          "P1 Select",
          "P1 Start",
          "P1 Up",
          "P1 Down",
          "P1 Left",
          "P1 Right",
          "P2 A",
          "P2 B",
          "P2 Select",
          "P2 Start",
          "P2 Up",
          "P2 Down",
          "P2 Left",
          "P2 Right",
          "Reset"
        ],
        "mnemonics": {
          "A": "A",
          "B": "B",
          "Select": "s",
          "Start": "S",
          "Up": "U",
          "Down": "D",
          "Left": "L",
          "Right": "R",
          "Reset": "r"
        }
      },
      "extensions": {
        ".nes": "NES"
      }
    },
    {
      "id": "NES",
      "label": "Famicom Disk System",
      "when": [
        "fds"
      ],
      "extensions": {
        ".fds": "NES"
      }
    }
  ],
  "romFile": "rom",
  "deterministic": true,
  "memoryLayoutMiB": [
    16,
    16,
    8,
    16,
    16
  ],
  "_memoryLayoutMiB_note": "sbrk, sealed, invis, plain, mmap. Every savestate costs work proportional to the DECLARED layout, not to what the core uses, so this is sized for an NES cart (a few hundred KB of machine plus the PRG image) rather than left generous.",
  "video": {
    "width": 256,
    "height": 240,
    "virtualWidth": 293,
    "virtualHeight": 240,
    "vsyncNumerator": 3579546,
    "vsyncDenominator": 59561,
    "_vsync_note": "NesHawk's NTSC rate (cpuclockrate*2 / 59561). The region is a user setting, so the core answers GetVsyncNumerator/GetVsyncDenominator after Init and those win; these are the fallback.",
    "getBgra": "GetVideoBgra"
  },
  "audio": {
    "samplesPerFrame": 1024,
    "_samplesPerFrame_note": "capacity, not the count: the core exports GetAudioSampleCount and hands over the real number each frame (~735 NTSC, ~882 PAL).",
    "channels": 1,
    "get": "GetAudio"
  },
  "input": {
    "name": "NES Controller",
    "buttons": [
      "P1 A",
      "P1 B",
      "P1 Select",
      "P1 Start",
      "P1 Up",
      "P1 Down",
      "P1 Left",
      "P1 Right",
      "P2 A",
      "P2 B",
      "P2 Select",
      "P2 Start",
      "P2 Up",
      "P2 Down",
      "P2 Left",
      "P2 Right",
      "Reset",
      "FDS Eject",
      "FDS Insert 0",
      "FDS Insert 1",
      "FDS Insert 2",
      "FDS Insert 3"
    ],
    "mnemonics": {
      "A": "A",
      "B": "B",
      "Select": "s",
      "Start": "S",
      "Up": "U",
      "Down": "D",
      "Left": "L",
      "Right": "R",
      "Reset": "r",
      "FDS Eject": "E",
      "FDS Insert 0": "0",
      "FDS Insert 1": "1",
      "FDS Insert 2": "2",
      "FDS Insert 3": "3"
    }
  },
  "lag": {
    "inputWasRead": "InputWasRead"
  },
  "settings": [
    {
      "name": "machine",
      "display": "Machine",
      "description": "Which machine this project is: a cartridge console, or a console with the Famicom Disk System attached. The wizard asks this first because everything after it depends on the answer. A cartridge project takes a .nes file and needs no firmware. A Disk System project takes a .fds file and starts through the Disk System's BIOS. The choice is saved in the project and recorded in the movie, and is never guessed from a file name.",
      "type": "enum",
      "options": [
        "nes",
        "fds"
      ],
      "default": "nes"
    },
    {
      "name": "region",
      "display": "Region",
      "description": "Which regional model this is. It changes the frame rate, the processor speed and the number of lines the video chip draws, so changing it restarts the core. BizHawk's 'Default' looks the region up in its cartridge database. This core has no such database and starts as NTSC.",
      "type": "enum",
      "options": [
        "ntsc",
        "pal",
        "dendy"
      ],
      "default": "ntsc"
    },
    {
      "name": "port1",
      "display": "Left Port Peripheral",
      "description": "What is plugged into controller port 1. Only the standard controller is supported so far. NesHawk also offers light guns, Arkanoid paddles and the Four Score adapter.",
      "type": "enum",
      "options": [
        "none",
        "gamepad"
      ],
      "default": "gamepad"
    },
    {
      "name": "port2",
      "display": "Right Port Peripheral",
      "description": "What is plugged into controller port 2. An empty port always reads as 0, which a game can tell apart from a connected controller. Some games and glitches depend on it.",
      "type": "enum",
      "options": [
        "none",
        "gamepad"
      ],
      "default": "none"
    },
    {
      "name": "initialWRamStatePattern",
      "display": "Initial RAM State",
      "description": "The bytes the console's 2 KB of main memory hold at power-on, written in hex (for example 'FF' or 'DE AD BE EF'). Empty means the pattern FCEUX uses, which is also NesHawk's default. A few games (Cybernoid, Huang Di) behave differently with another pattern.",
      "type": "string",
      "default": ""
    },
    {
      "name": "allowMoreThanEightSprites",
      "display": "Allow More Than Eight Sprites",
      "description": "Draws every sprite on a line instead of the eight the real console can show, which removes flicker. BizHawk treats this as a display option. It can change a timing signal some games rely on (the sprite-zero hit), though, so here it is part of the machine and changing it restarts the core.",
      "type": "bool",
      "default": false
    },
    {
      "name": "palette",
      "display": "Palette",
      "description": "Which of NesHawk's colour palettes the picture uses. 'quickNES' is the default. '2c03' and '2c04' are the palettes of the arcade versions of the video chip.",
      "type": "enum",
      "options": [
        "quickNES",
        "fceux",
        "2c03_2c05",
        "2c04_001",
        "2c04_002",
        "2c04_003",
        "2c04_004"
      ],
      "default": "quickNES"
    },
    {
      "name": "dispBackground",
      "display": "Display Background",
      "description": "Draws the background layer. It changes the picture only. The video chip still processes the layer, so the game's timing is not affected.",
      "type": "bool",
      "default": true
    },
    {
      "name": "dispSprites",
      "display": "Display Sprites",
      "description": "Draws the sprite layer. It changes the picture only, like Display Background.",
      "type": "bool",
      "default": true
    },
    {
      "name": "clipLeftAndRight",
      "display": "Clip Left and Right",
      "description": "Blanks the 8 leftmost and 8 rightmost columns of the picture. Real televisions cut them off, and many games leave garbage there. BizHawk makes the picture narrower. Here the picture keeps its size and the columns are black.",
      "type": "bool",
      "default": false
    },
    {
      "name": "backgroundColor",
      "display": "Backdrop Colour",
      "description": "The colour used for pixels the video chip never drew, as 0xRRGGBB written as a decimal number. -1 leaves them in the palette's own background colour, as NesHawk does by default.",
      "type": "int",
      "min": -1,
      "max": 16777215,
      "default": -1
    },
    {
      "name": "ntscTopLine",
      "display": "NTSC First Scanline",
      "description": "The first picture line shown on an NTSC machine. NesHawk crops the picture. Here the picture keeps its size and the lines outside are black.",
      "type": "int",
      "min": 0,
      "max": 239,
      "default": 8
    },
    {
      "name": "ntscBottomLine",
      "display": "NTSC Last Scanline",
      "description": "The last picture line shown on an NTSC machine.",
      "type": "int",
      "min": 0,
      "max": 239,
      "default": 231
    },
    {
      "name": "palTopLine",
      "display": "PAL First Scanline",
      "description": "The first picture line shown on a PAL or Dendy machine.",
      "type": "int",
      "min": 0,
      "max": 239,
      "default": 0
    },
    {
      "name": "palBottomLine",
      "display": "PAL Last Scanline",
      "description": "The last picture line shown on a PAL or Dendy machine.",
      "type": "int",
      "min": 0,
      "max": 239,
      "default": 239
    },
    {
      "name": "apuVolume",
      "display": "APU Volume",
      "description": "The volume of the sound chip, from 1 to 10. It is the same as NesHawk's APU volume slider.",
      "type": "int",
      "min": 1,
      "max": 10,
      "default": 1
    },
    {
      "name": "fdsBios",
      "display": "FDS BIOS to Use",
      "description": "Which Disk System BIOS the machine starts with. It is shown only for a Famicom Disk System project, and it decides which firmware file the wizard's firmware page asks for.",
      "type": "enum",
      "options": [
        "nintendo",
        "twinFamicom"
      ],
      "default": "nintendo",
      "exposedWhen": {
        "setting": "machine",
        "is": "fds"
      }
    }
  ],
  "firmware": [
    {
      "id": "bios",
      "display": "Family Computer Disk System BIOS",
      "description": "The 8 KB boot ROM inside the Disk System's RAM adapter. A Famicom disk cannot start without it. The 'FDS BIOS to Use' setting chooses which dump. A cartridge needs none.",
      "size": 8192,
      "sha1": "57FE1BDEE955BB48D357E463CCBF129496930B62",
      "name": "disksys.rom",
      "label": "Nintendo FDS",
      "requiredWhen": {
        "all": [
          {
            "setting": "machine",
            "is": "fds"
          },
          {
            "setting": "fdsBios",
            "is": "nintendo"
          }
        ]
      }
    },
    {
      "id": "bios",
      "display": "Family Computer Disk System BIOS",
      "description": "The 8 KB boot ROM inside the Disk System's RAM adapter. A Famicom disk cannot start without it. The 'FDS BIOS to Use' setting chooses which dump. A cartridge needs none.",
      "size": 8192,
      "sha1": "E4E41472C454F928E53EB10E0509BF7D1146ECC1",
      "name": "disksys.rom",
      "label": "Sharp Twin Famicom",
      "requiredWhen": {
        "all": [
          {
            "setting": "machine",
            "is": "fds"
          },
          {
            "setting": "fdsBios",
            "is": "twinFamicom"
          }
        ]
      }
    }
  ]
}
